    {
      "parameters": {
        "jsCode": "const readmeData = $input.first().json;\nconst wfData = $('📝 Generate HTML').first().json;\n\nconst currentContent = Buffer.from(readmeData.content, 'base64').toString('utf8');\nconst sha = readmeData.sha;\n\nconst githubUrl = 'https://github.com/Josemanuelhr/n8n-workflows-docs/blob/main/' + wfData.slug + '/overview.html';\nconst today = new Date().toISOString().split('T')[0];\nconst newEntry = '| [' + wfData.name + '](' + wfData.slug + '/overview.html) | ' + today + ' | [Ver HTML](' + githubUrl + ') |';\n\nlet lines = currentContent.split('\\n');\nconst existingIdx = lines.findIndex(function(l) { return l.includes('(' + wfData.slug + '/'); });\n\nif (existingIdx >= 0) {\n  lines[existingIdx] = newEntry;\n} else {\n  lines.push(newEntry);\n}\n\nconst newContent = lines.join('\\n');\nconst bodyObj = {\n  message: 'docs: add ' + wfData.name + ' to index',\n  content: Buffer.from(newContent).toString('base64'),\n  sha: sha\n};\n\nconst result = { body: JSON.stringify(bodyObj), name: wfData.name, slug: wfData.slug };\nreturn [{ json: result }];"
      },
