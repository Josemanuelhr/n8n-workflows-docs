      "parameters": {
        "jsCode": "const checkResult = $input.first().json;\nconst wfData = $('📝 Generate HTML').first().json;\n\nconst body = {\n  message: `docs: update ${wfData.name} overview`,\n  content: Buffer.from(wfData.html).toString('base64')\n};\n\nif (checkResult.sha) {\n  body.sha = checkResult.sha;\n}\n\nreturn [{ json: { body: JSON.stringify(body), slug: wfData.slug, name: wfData.name, id: wfData.id, workflowJson: wfData.workflowJson } }];"
      },
