      "id": "node-wf1-03",
      "name": "Get Workflow from n8n",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        448,
        304
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "zld70Zc5aXVWOJw5",
          "name": "n8n API Key"
        }
      },
      "notes": "Asignar credential: 'n8n API Key' (Header Auth: X-N8N-API-KEY)"
    },
    {
      "parameters": {
        "jsCode": "const wf = $input.first().json;\nconst slug = wf.name.toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');\nconst nodes = wf.nodes || [];\nconst nodeRows = nodes.map(n => `<tr><td>${n.name}</td><td style='color:#666'>${n.type.replace('n8n-nodes-base.','')}</td></tr>`).join('\\n');\n\nconst html = `<!DOCTYPE html>\\n<html lang='es'>\\n<head>\\n<meta charset='UTF-8'>\\n<title>${wf.name} — n8n Docs</title>\\n<style>\\nbody{font-family:sans-serif;max-width:900px;margin:40px auto;padding:20px;color:#333}\\nh1{color:#ea4b71}h2{margin:24px 0 12px;border-bottom:2px solid #f0f0f0;padding-bottom:6px}\\n.meta{font-size:14px;color:#666;margin-bottom:20px}\\n.badge{padding:3px 10px;border-radius:12px;font-size:12px}\\n.active{background:#d4edda;color:#155724}.inactive{background:#f8d7da;color:#721c24}\\ntable{width:100%;border-collapse:collapse;font-size:14px}\\nth,td{border:1px solid #e8e8e8;padding:10px;text-align:left}th{background:#f8f9fa}\\n.btn{display:inline-block;margin-top:20px;padding:10px 20px;background:#ea4b71;color:white;text-decoration:none;border-radius:6px}\\n</style>\\n</head>\\n<body>\\n<h1>${wf.name}</h1>\\n<div class='meta'>\\nID: <code>${wf.id}</code> &nbsp;|&nbsp;\\nEstado: <span class='badge ${wf.active?'active':'inactive'}'>${wf.active?'✅ Activo':'⏸ Inactivo'}</span> &nbsp;|&nbsp;\\nNodos: <strong>${nodes.length}</strong> &nbsp;|&nbsp;\\nDocumentado: <strong>${new Date().toISOString().split('T')[0]}</strong>\\n</div>\\n<h2>Nodos del workflow</h2>\\n<table><thead><tr><th>Nombre</th><th>Tipo</th></tr></thead><tbody>\\n${nodeRows}\\n</tbody></table>\\n<a class='btn' href='https://test-n8n-n8n.qkyvh9.easypanel.host/workflow/${wf.id}' target='_blank'>🔗 Abrir en n8n</a>\\n<p style='margin-top:40px;font-size:12px;color:#999'>Generado: ${new Date().toISOString()}</p>\\n</body>\\n</html>`;\n\nreturn [{ json: { html, workflowJson: JSON.stringify(wf, null, 2), slug, name: wf.name, id: wf.id } }];"
      },
